page = PAGE
page {

  # Allgemeine Seiteneigenschaften setzen
  config.doctype = html5

  # Meta-Tags angeben
  meta.author = Robert Meyer, Martin Helmich, Hannes Strangmeier
  meta.description = Hier steht eine Beschreibung
  meta.viewport = width=device-width, initial-scale=1

  # CSS-Dateien einfügen
  includeCSS {
    main = EXT:snowboard/Resources/Public/Css/index.css
    main.title = main
    main.media = all
  }

  # JS-Dateien einfügen
  includeJSFooter {
    main = EXT:snowboard/Resources/Public/JavaScript/index.js
  }

  # Die Designvorlage integrieren
  10 = PAGEVIEW
  10 {
    paths {
      10 = EXT:snowboard/Resources/Private/PageView/
    }

    dataProcessing {
      10 = files
      10 {
        as = images
        references.data = levelmedia:-1,slide
      }

      20 = menu
      20 {
        as = secondaryMenuItems
        special = directory
        special.value = {$navigation.secondaryStartpoint}
        levels = 1
      }
    }

    variables {
      brandLineFirst = TEXT
      brandLineFirst.value = Snowboardschule

      brandLineSecond = TEXT
      brandLineSecond.value = {$snowboardSchool.name}

      labelMore = TEXT
      labelMore.value = Mehr
    }
  }
}